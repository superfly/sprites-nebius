#!/usr/bin/env python3
"""Compile repository Python and run offline tests; never invoke agent CLIs."""
import ast
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
files = list(root.glob("*.py")) + list((root / "proxy").rglob("*.py"))
files += list((root / "tests").glob("*.py"))
for path in files:
    if ".venv" not in path.parts:
        ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
print(f"Parsed {len(files)} Python source files", flush=True)
raise SystemExit(subprocess.call([sys.executable, "-m", "unittest", "discover",
                                 "-s", "tests", "-v"], cwd=root))
